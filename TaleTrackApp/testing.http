@api = http://localhost:5112
@contentType = application/json
@token = a
@userId = a
@mediaId = 1
@reviewId = 1


POST {{api}}/api/login
Content-Type: {{contentType}}

{
  "email": "newuser@example.com",
  "password": "SecurePassword123"
}

POST {{api}}/api/register
Content-Type: {{contentType}}

{
  "email": "newuser2@example.com",
  "username": "newuser",
  "password": "SecurePassword123"
}

POST {{api}}/api/media
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{
  "title": "The Last of Us",
  "type": "Series",
  "length": 9
}

POST {{api}}/api/tracking/series
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{
  "title": "The Last of Us",
  "season": 1,
  "episode": 3,
  "minutes": 50,
  "progress": 50
}

GET {{api}}/api/library?type=Series&limit=10
Authorization: Bearer {{token}}

GET {{api}}/api/media/{{mediaId}}
Authorization: Bearer {{token}}

PUT {{api}}/api/user/{{userId}}
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{
  "username": "newusername",
  "email": "newemail@example.com",
  "password": "NewPassword123"
}

DELETE {{api}}/api/user/{{userId}}
Authorization: Bearer {{token}}

PUT {{api}}/api/review/{{reviewId}}
Content-Type: {{contentType}}
Authorization: Bearer {{token}}

{
  "rating": 9,
  "comment": "Actually it's even better!"
}

DELETE {{api}}/api/review/{{reviewId}}
Authorization: Bearer {{token}}
