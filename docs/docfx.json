{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "../TaleTrackApp",
          "files": ["TaleTrackApp.csproj"]
        }
      ],
      "output": "backend/api",
      "filter": "filterConfig.yml",
      "namespaceLayout": "nested",
      "memberLayout": "separatePages",
      "includePrivateMembers": true
    }
  ],
  "build": {
    "content": [
      {
        "files": ["**/*.{md,yml}"],
        "exclude": ["_site/**", "node_modules/**", "ts/**", "filterConfig.yml"]
      }
    ],
    "resource": [
      {
        "files": ["ts/**"]
      }
    ],
    "output": "_site",
    "template": ["default", "modern"],
    "globalMetadata": {
      "_appName": "TaleTrack",
      "_appTitle": "TaleTrack",
      "_enableSearch": true,
      "_disableContribution": true
    }
  }
}
